# Copy this file to `secrets.yaml` (git-ignored) and fill in real values.
#   cp secrets.yaml.example secrets.yaml

wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# Fallback AP password (>= 8 chars).
ap_password: "poolbridge-setup"

# ESPHome API encryption key — generate one:
#   openssl rand -base64 32
api_key: "REPLACE_WITH_BASE64_32_KEY"

# OTA update password — choose anything.
ota_password: "REPLACE_WITH_OTA_PASSWORD"
