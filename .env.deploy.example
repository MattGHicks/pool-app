# Production secrets for docker-compose / Coolify. Copy to .env (git-ignored) on
# the T630, or set each as an env var in Coolify. Generate the values:
#
#   DB_PASSWORD       openssl rand -base64 24
#   SESSION_SECRET    openssl rand -base64 48
#   POOL_PASSWORD_HASH  pnpm --filter @pool/api hash-password '<your password>'
#   KEEP_ALIVE_MS     from the revert-timeout calibration (default 5000 until measured)

DB_PASSWORD=
SESSION_SECRET=
POOL_PASSWORD_HASH=
KEEP_ALIVE_MS=5000
