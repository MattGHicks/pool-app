# ---- pool-api ----
BRIDGE_HOST=192.168.4.60
BRIDGE_PORT=8899
DATABASE_URL=postgres://pool:changeme@localhost:5432/pool
POLL_MS=1000
KEEP_ALIVE_MS=5000
# Force a reconnect when the bridge link goes quiet this long while the socket still
# claims to be connected — a stalled WiFi link otherwise leaves the pump without
# keep-alive until it reverts to its onboard schedule. Must stay inside the pump's
# ~3·KEEP_ALIVE_MS revert window.
BRIDGE_IDLE_MS=12000
BRIDGE_CONNECT_TIMEOUT_MS=8000
BRIDGE_WRITE_TIMEOUT_MS=3000
PUMP_ADDRESS=96
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# argon2 hash of the login password (generate with the api's `pnpm hash-password` script)
POOL_PASSWORD_HASH=

# ---- pool-web ----
NEXT_PUBLIC_API_URL=http://localhost:3001
INTERNAL_API_URL=http://localhost:3001
